# Copy to .env (git-ignored). `bun run dev` and `bun run build` read it from this folder.

# Google OAuth client for "Connect Google account" (a "Desktop app" client in Google Cloud Console; see MANUAL.md).
# `bun run build:main` inlines these into dist/main.js. Without them, Google stays off.
TEMPI_GOOGLE_CLIENT_ID=
TEMPI_GOOGLE_CLIENT_SECRET=

# Optional, dev only: the web dev server Electron loads. Defaults to http://localhost:3000; ignored by packaged builds.
# TEMPI_WEB_URL=http://localhost:3000
