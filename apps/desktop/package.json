{
  "name": "@tempi/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tempi desktop app (Electron shell around the static export of @tempi/web).",
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/tempi",
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "bun run build:main && bun run build:preload && bun run build:ical-worker",
    "build:csp": "bun scripts/csp-hashes.ts",
    "build:ical-worker": "bun build src/ical-worker.ts --target=node --format=esm --external electron --outfile dist/ical-worker.js",
    "build:main": "bun build src/main.ts --target=node --format=esm --external electron --env='TEMPI_GOOGLE_*' --outfile dist/main.js",
    "build:preload": "bun build src/preload.ts --target=node --format=cjs --external electron --outfile dist/preload.cjs",
    "dev": "bun scripts/dev.ts",
    "dist:linux": "bun run build && bun run build:csp && electron-builder --linux --publish never",
    "dist:mac": "bun run build && bun run build:csp && electron-builder --mac --publish never",
    "dist:win": "bun run build && bun run build:csp && electron-builder --win --publish never",
    "reset:dev": "bun scripts/reset-dev-data.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:fuses": "bun scripts/verify-fuses.ts"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@tempi/ai": "workspace:*",
    "@tempi/core": "workspace:*",
    "@tempi/db": "workspace:*",
    "@tempi/i18n": "workspace:*",
    "@tempi/ical": "workspace:*",
    "@tempi/ipc": "workspace:*",
    "@tempi/sync-google": "workspace:*",
    "@types/node": "catalog:",
    "@usemeshly/auth": "catalog:",
    "@usemeshly/google-calendar": "catalog:",
    "@usemeshly/open-meteo": "catalog:",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "build": {
    "appId": "com.sebastianurdanegui.tempi",
    "productName": "Tempi",
    "artifactName": "Tempi-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "public/**/*", "package.json"],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/tempi-icon-mac.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tempi uses the microphone only while you dictate to the AI assistant. Audio is sent to ElevenLabs for transcription and never stored."
      }
    },
    "win": {
      "icon": "public/tempi-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Office",
      "executableName": "tempi",
      "icon": "public/tempi-icon.png",
      "maintainer": "Sebastian Marat Urdanegui Bisalaya <sebasurdanegui@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "SebastianUrdaneguiBisalaya",
      "repo": "tempi",
      "releaseType": "draft"
    }
  }
}
