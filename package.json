{
  "name": "tempi",
  "private": true,
  "license": "ISC",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@ai-sdk/anthropic": "4.0.105",
      "@ai-sdk/google": "4.0.121",
      "@ai-sdk/groq": "4.0.84",
      "@ai-sdk/openai": "4.0.118",
      "@ai-sdk/provider": "4.0.38",
      "@ai-sdk/xai": "5.0.46",
      "@elevenlabs/elevenlabs-js": "2.79.0",
      "@gsap/react": "2.1.2",
      "@tailwindcss/turbopack": "4.3.3",
      "@types/node": "26.6.6",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "ai": "7.0.173",
      "gsap": "3.15.1",
      "next": "16.4.6",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "build": "bun run --filter '@tempi/*' build",
    "build:desktop": "bun run --filter @tempi/web build && bun run --filter @tempi/desktop build",
    "check": "biome check --write .",
    "dev:desktop": "bun run --filter @tempi/desktop dev",
    "dev:web": "bun run --filter @tempi/web dev",
    "dev:www": "bun run --filter @tempi/www dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepare": "husky",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run --filter '@tempi/*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.2",
    "husky": "9.1.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": ["electron", "sharp", "unrs-resolver"]
}
